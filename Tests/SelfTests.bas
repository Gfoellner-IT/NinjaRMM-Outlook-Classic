Attribute VB_Name = "SelfTests"
' SelfTests v0.1.0
'
' Tests of the test framework itself (TestAssert) and of the generated
' fixtures module. They prove that the runner can detect pass and fail.

Option Explicit

Public Sub Test_AreEqual_Strings()
    TestAssert.AssertTrue TestAssert.AreEqual("abc", "abc"), "same strings"
    TestAssert.AssertFalse TestAssert.AreEqual("abc", "ABC"), "case sensitive"
    TestAssert.AssertFalse TestAssert.AreEqual("1", 1), "string vs number are different"
    TestAssert.AssertTrue TestAssert.AreEqual("", ""), "empty strings"
End Sub

Public Sub Test_AreEqual_Numbers()
    TestAssert.AssertTrue TestAssert.AreEqual(5, 5), "same integers"
    TestAssert.AssertTrue TestAssert.AreEqual(5, 5#), "integer vs double"
    TestAssert.AssertTrue TestAssert.AreEqual(6000&, 6000), "long vs integer"
    TestAssert.AssertFalse TestAssert.AreEqual(5, 6), "different numbers"
    TestAssert.AssertTrue TestAssert.AreEqual(True, True), "booleans"
    TestAssert.AssertTrue TestAssert.AreEqual(DateSerial(2026, 10, 7), DateSerial(2026, 10, 7)), "dates"
    TestAssert.AssertFalse TestAssert.AreEqual(DateSerial(2026, 10, 7), DateSerial(2026, 10, 8)), "different dates"
End Sub

Public Sub Test_AreEqual_NullEmptyObject()
    Dim c1 As Collection
    Dim c2 As Collection

    TestAssert.AssertTrue TestAssert.AreEqual(Null, Null), "Null equals Null"
    TestAssert.AssertFalse TestAssert.AreEqual(Null, ""), "Null vs empty string"
    TestAssert.AssertTrue TestAssert.AreEqual(Empty, Empty), "Empty equals Empty"
    TestAssert.AssertFalse TestAssert.AreEqual(Empty, 0), "Empty vs zero"

    Set c1 = New Collection
    Set c2 = New Collection
    TestAssert.AssertTrue TestAssert.AreEqual(c1, c1), "same object"
    TestAssert.AssertFalse TestAssert.AreEqual(c1, c2), "different objects"
End Sub

Public Sub Test_Describe()
    TestAssert.AssertEqual "String:abc", TestAssert.Describe("abc")
    TestAssert.AssertEqual "Long:42", TestAssert.Describe(42&)
    TestAssert.AssertEqual "Null", TestAssert.Describe(Null)
    TestAssert.AssertEqual "Empty", TestAssert.Describe(Empty)
End Sub

' The Fixtures module is generated by tools/New-FixturesModule.ps1.
Public Sub Test_Fixtures_Available()
    TestAssert.AssertTrue Left$(Fixtures.TicketOpen(), 1) = "{", "ticket_open is a JSON object"
    TestAssert.AssertTrue Left$(Fixtures.TicketClosed(), 1) = "{", "ticket_closed is a JSON object"
    TestAssert.AssertTrue Left$(Fixtures.LogClosedManual(), 1) = "[", "log_closed_manual is a JSON array"
    TestAssert.AssertTrue InStr(Fixtures.TicketClosed(), """statusId"":6000") > 0, "closed ticket has statusId 6000"
    TestAssert.AssertTrue InStr(Fixtures.TicketOpen(), """statusId"":2000") > 0, "open ticket has statusId 2000"
End Sub

' ---------------------------------------------------------------------------
'  Probes: deliberately failing tests, only used by TestRunner.RunFailureProbe
' ---------------------------------------------------------------------------

Public Sub Probe_AssertionFails()
    TestAssert.AssertEqual 1, 2, "probe: this assertion must fail"
End Sub

Public Sub Probe_RaisesError()
    Err.Raise 5, "SelfTests.Probe_RaisesError", "probe: this error must be reported"
End Sub

Public Sub Probe_Passes()
    TestAssert.AssertTrue True
End Sub
